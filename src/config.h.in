#pragma once

#include <raylib.h>

namespace game {
    class Config final {
    public:
        inline static constexpr const char* kProjectName = "@PROJECT_NAME@";
        inline static constexpr const char* kProjectVersion = "@PROJECT_VERSION@";
        inline static constexpr const char* kProjectVersionMajor = "@PROJECT_VERSION_MAJOR@";
        inline static constexpr const char* kProjectVersionMinor = "@PROJECT_VERSION_MINOR@";
        inline static constexpr const char* kProjectVersionPatch = "@PROJECT_VERSION_PATCH@";

        // Width and Height of the game stage. The stage will be scaled with the window size
        inline static constexpr int kStageWidth = 1920;
        inline static constexpr int kStageHeight = 1080;

        // Target FPS, default is 60 fps
        inline static constexpr int kTargetFps = 60;

        // Start game in window or fullscreen mode
        inline static constexpr const bool kFullScreen = false;

        // Define if the game uses a mouse/mouse pointer
        // The mouse position is then accessible in game::core::Store in the mouse_position attribute
        // Please do not use the Raylib function GetMousePosition()
        inline static constexpr const bool kUseMouse = false;

        // Raylib window config flags, e.g. for resizable window and vertical synchronisation
        // Default: GAME_CONFIG_FLAGS FLAG_WINDOW_RESIZABLE | FLAG_VSYNC_HINT | FLAG_MSAA_4X_HINT
        inline static constexpr const int kWindowFlags = FLAG_WINDOW_RESIZABLE | FLAG_VSYNC_HINT | FLAG_MSAA_4X_HINT;

        // Texture scale filter to use, e.g. TEXTURE_FILTER_POINT, TEXTURE_FILTER_BILINEAR etc.
        // Default: TEXTURE_FILTER_POINT for no filter, only pixel approximation
        inline static constexpr const int kTextureFilter = TEXTURE_FILTER_POINT;

        // Define Raylib exit key - KEY_NULL means that no key leads to the termination of the program
        // Raylib default is KEY_ESCAPE
        inline static constexpr const int kExitKey = KEY_NULL;

        // Defines if Raylib audio should be enabled
        inline static constexpr const bool kAudio = true;

        // Player Settings
        inline static constexpr bool enable_Health_Drain = true; // HP-Drain durch Zeit an/aus
        inline static constexpr float player_Health_Drain_Rate = 1.0f; // HP-Verlust pro Sekunde

        //____________________Spieler Klasse 1 Block____________________________
        inline static constexpr bool allow_Move_While_Attacking = true;
        inline static constexpr int player_Class_One_Max_Health = 120;
        inline static constexpr float player_Class_One_Movement_Speed = 20.0f;
        inline static constexpr int player_Class_One_Damage = 12;
        inline static constexpr Vector2 player_Spawn_Position{200,200};
        inline static constexpr Vector2 player_Hittbox{16,16};

            // Player_Class_One Animations

            // Beispielwert: 5.0f bedeutet 0.5 Sekunden pro Frame (2 Frames pro Sekunde)

            inline static constexpr float player_Walk_Anim_Speed = 10.0f;
            inline static constexpr int player_Walk_Frame_Count = 5;
            inline static constexpr Vector2 player_Walk_Anim_Size{16,16};
            inline static constexpr const char* kPlayerWalkUpAnim = "../../PieWare/assets/Spritesheets/Gnome_Walking_Up.png";
            inline static constexpr const char* kPlayerWalkDownAnim = "../../PieWare/assets/Spritesheets/Gnome_Walking_Down.png";
            inline static constexpr const char* kPlayerWalkLeftAnim = "../../PieWare/assets/Spritesheets/Gnome_Walking_Left.png";
            inline static constexpr const char* kPlayerWalkRightAnim = "../../PieWare/assets/Spritesheets/Gnome_Walking_Right.png";

            inline static constexpr float player_Idle_Anim_Speed = 10.0f;
            inline static constexpr int player_Idle_Frame_Count = 5;
            inline static constexpr Vector2 player_Idle_Anim_Size{16,16};
            inline static constexpr const char* kPlayerIdleUpAnim = "../../PieWare/assets/Spritesheets/Gnome_IdleAnimation_Up.png";
            inline static constexpr const char* kPlayerIdleDownAnim = "../../PieWare/assets/Spritesheets/Gnome_IdleAnimation_Down.png";
            inline static constexpr const char* kPlayerIdleLeftAnim = "../../PieWare/assets/Spritesheets/Gnome_IdleAnimation_Left.png";
            inline static constexpr const char* kPlayerIdleRightAnim = "../../PieWare/assets/Spritesheets/Gnome_IdleAnimation_Right.png";

            inline static constexpr float player_Ranged_Attack_Anim_Speed = 10.0f;
            inline static constexpr int player_Ranged_Attack_Frame_Count = 5;
            inline static constexpr Vector2 player_Ranged_Attack_Anim_Size{32,32};
            inline static constexpr const char* kPlayerRangeAttackUpAnim = "../../PieWare/assets/Spritesheets/Gnome_ArrowAttack_Up.png";
            inline static constexpr const char* kPlayerRangeAttackDownAnim = "../../PieWare/assets/Spritesheets/Gnome_ArrowAttack_Down.png";
            inline static constexpr const char* kPlayerRangeAttackLeftAnim = "../../PieWare/assets/Spritesheets/Gnome_ArrowAttack_Leftt.png";
            inline static constexpr const char* kPlayerRangeAttackRightAnim = "../../PieWare/assets/Spritesheets/Gnome_ArrowAttack_Right.png";
            inline static constexpr const char* kPlayerRangeAttackUpLeftAnim = "../../PieWare/assets/Spritesheets/gnoooomeRangedLeftUp.png";
            inline static constexpr const char* kPlayerRangeAttackUpRightAnim = "../../PieWare/assets/Spritesheets/gnoooomeRangedRightUp.png";
            inline static constexpr const char* kPlayerRangeAttackDownLeftAnim = "../../PieWare/assets/Spritesheets/gnoooomeRangedLeftDown.png";
            inline static constexpr const char* kPlayerRangeAttackDownRightAnim = "../../PieWare/assets/Spritesheets/gnoooomeRangedRightDown.png";

            // Player_Range_Attack
            inline static constexpr float player_Class_One_Projectile_Speed = 40.0f;
            inline static constexpr float player_Ranged_Attack_Duration = 2.0f;
            inline static constexpr float player_Ranged_Attack_Cooldown = 5.0f; // 10 = 1 Sekunde
            inline static constexpr int projectile_Anim_Frame_Count = 9;
            inline static constexpr Vector2 projectile_Anim_Size = {8, 8};
            inline static constexpr Vector2 projectile_Hitbox_Size = {8, 8};
            inline static constexpr float projectile_Anim_Speed = 4.0f;
            inline static constexpr float player_Ranged_Damage_Factor = 0.8f;

            inline static constexpr const char* kProjectileSprite = "../../PieWare/assets/Spritesheets/Projectile_Right.png";

        //____________________Gegner 1 Block____________________________
       // Melee_Enemy_Type1 Settings
       inline static constexpr int melee_enemy_1_health = 80;
       inline static constexpr float melee_enemy_1_movement_speed = 8.0f;
       inline static constexpr Vector2 melee_enemy_1_hitbox = {16, 24};

       // Melee_Enemy_Type1 Attack
       inline static constexpr int melee_enemy_1_damage = 10;
       inline static constexpr float melee_enemy_1_attack_range = 20.0f; // Reichweite, in der der Angriff startet
       inline static constexpr float melee_enemy_1_attack_duration = 0.6f; // Dauer der Angriffsanimation
       inline static constexpr float melee_enemy_1_attack_cooldown = 1.5f; // Abklingzeit bis zum nächsten Angriff

       // Melee_Enemy_Type1 Animations
       inline static constexpr float melee_enemy_1_walk_anim_speed = 8.0f;
       inline static constexpr int melee_enemy_1_walk_frame_count = 12;
       inline static constexpr Vector2 melee_enemy_1_walk_anim_size = {32, 32};
       inline static constexpr const char* kMeleeEnemy1WalkLeftAnim = "../../PieWare/assets/Spritesheets/EnemyBauer_WalkingLeft_Lv1.png";
       inline static constexpr const char* kMeleeEnemy1WalkRightAnim = "../../PieWare/assets/Spritesheets/EnemyBauer_WalkingLeft_Lv1.png";

       inline static constexpr float melee_enemy_1_attack_anim_speed = 5.0f;
       inline static constexpr int melee_enemy_1_attack_frame_count = 10;
       inline static constexpr Vector2 melee_enemy_1_attack_anim_size = {64, 32};
       inline static constexpr const char* kMeleeEnemy1AttackLeftAnim = "../../PieWare/assets/Spritesheets/EnemyBauer_AttackLeft_Lv1.png";
       inline static constexpr const char* kMeleeEnemy1AttackRightAnim = "../../PieWare/assets/Spritesheets/EnemyBauer_AttackRightt_Lv1.png"; // Achtung: "Rightt"?

        // Control Settings
        inline static constexpr const int key_Up = KEY_W;
        inline static constexpr const int key_Down = KEY_S;
        inline static constexpr const int key_Left = KEY_A;
        inline static constexpr const int key_Right = KEY_D;

        inline static constexpr const int key_Melee_Attack = KEY_J;
        inline static constexpr const int key_Ranged_Attack = KEY_K;
        inline static constexpr const int key_Use_Item = KEY_L;

        //Cam stuff
        inline static constexpr const int cam_start_pos_x = 0;
        inline static constexpr const int cam_start_pos_y = 0;
        inline static constexpr const float cam_zoom = 5;

         // Levelmap-file paths
                // Lvl_Nbr gets changed on level transition, thus also altering the path where Screen.Draw_Level() loads the
                // levelmap from
                inline static std::string GetLevelMapPath(int Lvl_Nbr) {
                    switch (Lvl_Nbr) {
                        case 1:
                            return "../../assets/Tiled/Levelmaps/Level_1.json";
                        case 2:
                            return "../../assets/Tiled/Levelmaps/lvl2.json";
                        case 3:
                            return "assets/maps/level3.json";
                        default:
                            return "assets/maps/default.json";
                    }
                }

    };
}
